# ==============================================================================
# EPIC CLUB PORTAL & REGISTRATION BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Database Storage File Path (SQLite file, automatically created and migrated)
DATABASE_PATH=data/epic_club.db

# Telegram Bot Integration Credentials
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=epic_club_setif_bot

# Default Telegram Group / Channel Chat ID for cohort invitations (e.g. -100xxxxxxxxxx)
TELEGRAM_TARGET_CHAT_ID=-1002345678901

# Default validity window for single-use invitation links in hours
DEFAULT_EXPIRY_HOURS=48

# Administrative Security & Default Credentials
# Used to seed the initial SuperAdmin account if none exists in the database
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=EpicAdmin2026!

# Session Management
SESSION_SECRET=replace_with_a_long_random_cryptographic_secret_in_production
SESSION_MAX_AGE_HOURS=8
